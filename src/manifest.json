{
  "manifest_version": 3,
  "name": "Startup Tab Suspender",
  "version": "1.0.1",
  "description": "Keeps restored background tabs unloaded on startup until you click them.",
  "homepage_url": "https://github.com/SamSpiri/startup-tab-suspender",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage"],
  "background": { "service_worker": "sw.js" }
}
